@startuml
autonumber
participant "main.ts\n<<entry point>>" as M
participant "Tracker" as T
participant "dump1090\n<<external>>" as D
participant "dump1090.ts\nparseSnapshot()" as Parser
participant "Collector\ningest()\n(US02)" as C

M -> T : start()
loop every POLL_INTERVAL (3 s)
  T -> T : run()
  activate T
  T -> T : tick(now)
  T -> D : GET aircraft.json (timeout 5 s)
  D --> T : 200 JSON

  alt HTTP error, timeout or invalid JSON
    T -> T : console.warn("dump1090 read failed")
  else success
    T -> Parser : parseSnapshot(json)
    activate Parser
    loop for each aircraft
      Parser -> Parser : parseAircraft(raw, now)
      note right
        discards invalid hex / "~"
        alt_baro|altitude, gs|speed
        ts = now - seen
        posTs = now - seen_pos
      end note
    end
    Parser --> T : Snapshot(now, messagesTotal, aircraft[])
    deactivate Parser
    T -> C : ingest(snap)
    T -> T : lastRead = now
  end
  T -> T : setTimeout(run, 3 s − elapsed)
  note right: always scheduled, even after a failure;\nticks never overlap
  deactivate T
end
@enduml
