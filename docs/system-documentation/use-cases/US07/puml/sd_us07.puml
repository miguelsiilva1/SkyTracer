@startuml
autonumber
actor "User" as U
participant "App Expo\n(Sprint 2)" as App
participant "Tracker\nfetch()" as API
database "Supabase\nPostgreSQL" as DB

U -> App : taps aircraft icon
App -> API : GET /aircraft/{hex}
activate API
API -> DB : select aircraft where hex = {hex}
DB --> API : identification + photo
alt unknown aircraft
  API --> App : 404
else
  API -> API : live state + route (memory)
  API --> App : 200 { ..., live: {...} }
end
deactivate API
App -> U : displays panel
loop messages from /ws/live (US06)
  App -> App : looks up hex in aircraft[]
  App -> U : updates altitude, speed, squawk
end
@enduml
