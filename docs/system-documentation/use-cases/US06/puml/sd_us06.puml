@startuml
autonumber
skinparam monochrome true
actor "Utilizador" as U
participant "App Expo\n(Sprint 2)" as App
participant "ws_live()" as WS
participant "LiveBroadcaster" as B
database "PostgreSQL" as DB

U -> App : abrir mapa
App -> WS : WS connect /ws/live
activate WS
WS -> WS : ws.accept()
WS -> B : fetch()
B -> DB : LIVE (max_age = 60 s)
DB --> B : linhas
B --> WS : JSON {ts, aircraft[]}
WS --> App : estado inicial
WS -> B : clients.add(ws)
App -> U : desenha ícones (rotação = track_deg)

== Ciclo do broadcaster (tarefa única, criada no lifespan) ==
loop a cada WS_INTERVAL_SECONDS
  opt existem clientes
    B -> DB : LIVE
    DB --> B : linhas
    B -> B : json.dumps(payload)
    par para cada cliente
      B -> App : wait_for(send_text(msg), 2 s)
      alt desligado / lento
        B -> B : clients.discard(ws); ws.close()
      end
    end
  end
end
App -> U : atualiza posições

== Desligar ==
App -> WS : close
WS -> B : clients.discard(ws)
deactivate WS
@enduml
