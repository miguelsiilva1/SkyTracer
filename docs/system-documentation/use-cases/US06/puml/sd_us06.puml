@startuml
autonumber
actor "User" as U
participant "App Expo" as App
participant "server.ts\n<<HTTP + ws>>" as S
participant "Tracker" as T

U -> App : open map
App -> S : WS connect /ws/live (upgrade)
activate S
S -> S : handleUpgrade()\n(maxPayload 1 KB)
S -> T : addClient(ws)
deactivate S
activate T
T -> T : clients.add(ws)
T -> T : liveMessage(now)
T --> App : initial state {ts, aircraft[]}
deactivate T
App -> U : draws icons (rotation = track_deg)

== Collection loop (US01), every 3 s ==
loop every POLL_INTERVAL
  T -> T : tick(now)
  opt clients not empty
    T -> T : liveMessage(now)\n(aircraft with position ≤ 60 s old)
    loop for each client
      alt more than 1 MB buffered
        T -> T : ws.terminate()
      else
        T -> App : send(message)
      end
    end
  end
end
App -> U : updates positions

== Disconnect ==
App -> T : close
T -> T : clients.delete(ws)
@enduml
