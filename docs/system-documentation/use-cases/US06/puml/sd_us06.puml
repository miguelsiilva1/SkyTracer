@startuml
autonumber
actor "User" as U
participant "App Expo\n(Sprint 2)" as App
participant "Worker\nfetch()" as W
participant "Tracker\n<<DurableObject>>" as T

U -> App : open map
App -> W : WS connect /ws/live
W -> T : forward request
activate T
T -> T : WebSocketPair()\nctx.acceptWebSocket(server)
note right: hibernatable WebSocket:\nkept by the runtime
T -> T : liveMessage(now)
T --> App : initial state {ts, aircraft[]}
T --> W : 101 Switching Protocols
deactivate T
App -> U : draws icons (rotation = track_deg)

== Collection loop (US01), every 3 s ==
loop every POLL_INTERVAL
  T -> T : tick(now)
  opt ctx.getWebSockets() not empty
    T -> T : liveMessage(now)\n(aircraft with position ≤ 60 s old)
    loop for each WebSocket
      T -> App : send(message)
      note right: errors ignored: the runtime\nremoves closed sockets
    end
  end
end
App -> U : updates positions

== Disconnect ==
App -> T : close
T -> T : webSocketClose(ws)
@enduml
