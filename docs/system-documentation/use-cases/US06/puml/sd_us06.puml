@startuml
autonumber
actor "User" as U
participant "App Expo\n(Sprint 2)" as App
participant "ws_live()" as WS
participant "LiveBroadcaster" as B
database "PostgreSQL" as DB

U -> App : open map
App -> WS : WS connect /ws/live
activate WS
WS -> WS : ws.accept()
WS -> B : fetch()
B -> DB : LIVE (max_age = 60 s)
DB --> B : rows
B --> WS : JSON {ts, aircraft[]}
WS --> App : initial state
WS -> B : clients.add(ws)
App -> U : draws icons (rotation = track_deg)

== Broadcaster loop (single task, created in lifespan) ==
loop every WS_INTERVAL_SECONDS
  opt clients exist
    B -> DB : LIVE
    DB --> B : rows
    B -> B : json.dumps(payload)
    par for each client
      B -> App : wait_for(send_text(msg), 2 s)
      alt disconnected / slow
        B -> B : clients.discard(ws); ws.close()
      end
    end
  end
end
App -> U : updates positions

== Disconnect ==
App -> WS : close
WS -> B : clients.discard(ws)
deactivate WS
@enduml
