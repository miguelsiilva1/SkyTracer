@startuml
autonumber
participant "Tracker\ntick()" as T
participant "Collector" as C
participant "Supabase\n(client)" as S
database "Supabase\nPostgreSQL" as DB

T -> C : ingest(snap)
activate C
loop for each aircraft in snapshot
  C -> C : live.set(hex, state)
  note right: in memory: callsign and\ncategory keep the last known value
  C -> C : aircraft.set(hex, {seen_at, category})
  opt hasFreshPosition and\nposTs - lastPosition[hex] >= 15 s
    C -> C : positions.push(row)\nlastPosition[hex] = posTs
  end
end
C -> C : remove from live aircraft\nnot seen for 300 s
opt >= 15 s since the last snapshot
  C -> C : snapshots.push(summary)
end
C --> T : number of positions queued
deactivate C

opt >= FLUSH_INTERVAL (15 s) since the last flush
  T -> C : takeBatch()
  C --> T : Batch {aircraft[], positions[], snapshots[]}
  T -> S : rpc("record_batch", batch)
  S -> DB : POST /rest/v1/rpc/record_batch
  activate DB
  DB -> DB : upsert aircraft\n(GREATEST(last_seen), COALESCE(category))
  DB -> DB : insert position
  DB -> DB : insert receiver_snapshot\nON CONFLICT DO NOTHING
  alt success
    DB --> S : 204
  else failure
    DB --> S : error
    S --> T : SupabaseError
    T -> C : restore(batch)
    note right: retried with the next flush\n(at most 20,000 positions kept)
  end
  deactivate DB
end

== Retention (pg_cron, daily at 03:17 UTC) ==
DB -> DB : DELETE position WHERE ts < now - 7 days
DB -> DB : DELETE receiver_snapshot WHERE ts < now - 7 days
@enduml
