@startuml
autonumber
participant "Enricher" as E
participant "ApiGate\ngetJson(url, now)" as G
participant "External API" as Ext

E -> G : ready(now)
G --> E : now >= nextAllowed
opt ready
  E -> G : getJson(url, now)
  activate G
  G -> G : nextAllowed = now + 1 s
  G -> Ext : GET (User-Agent, timeout 10 s)
  Ext --> G : response
  alt 404
    G --> E : not_found (negative cache)
  else 2xx
    G -> G : failures = 0
    G --> E : ok(json)
  else other 4xx / invalid JSON
    G --> E : error
  else 429 / 5xx / network error
    G -> G : delay = Retry-After\nor min(1 s * 2^failures, 60 s)
    G -> G : failures++\nnextAllowed = now + delay
    G --> E : retry
    note right of E : the item stays pending;\nafter 4 attempts it is cached as "error"
  end
  deactivate G
end
@enduml
