@startuml
autonumber
participant "fetch_*()" as F
participant "RateLimitedClient\nget_json(url)" as RL
participant "httpx.Client" as H
participant "External API" as Ext

F -> RL : get_json(url)
activate RL
loop attempt = 0 .. max_retries (4)
  RL -> RL : _throttle()
  note right
    waits next_allowed - clock()
    next_allowed = clock() + 1/rps
  end note
  RL -> H : get(url)
  H -> Ext : GET
  Ext --> H : response
  H --> RL : resp
  alt 404
    RL --> F : None (negative cache)
  else 2xx
    RL --> F : resp.json()
  else other 4xx / invalid JSON
    RL --> F : raise EnrichmentError
  else 429 / 5xx / TransportError
    RL -> RL : delay = Retry-After\nor min(base * 2^attempt, 60)
    RL -> RL : sleep(delay)
  end
end
RL --> F : raise EnrichmentError("failed after 5 attempts")
deactivate RL
@enduml
