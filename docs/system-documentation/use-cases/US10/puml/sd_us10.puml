@startuml
autonumber
actor "User" as U
participant "App Expo" as App
participant "Tracker\nhandle()" as API
database "Supabase\nPostgreSQL" as DB

U -> App : selects aircraft
App -> API : GET /aircraft/{hex}/track?minutes=60
activate API
API -> API : validates hex and 1 <= minutes <= 1440
API -> DB : GET /rest/v1/position?hex=eq.{hex}\n&ts=gt.{now - 60 min}&order=ts
note right of DB : index (hex, ts)
DB --> API : positions
API --> App : 200 [ {ts, lat, lon, altitude_ft, ...} ]
deactivate API
App -> U : draws line up to the current position\n(colour by altitude)
loop every 15 s while selected
  App -> API : GET /aircraft/{hex}/track?minutes=60
  API --> App : positions
end
@enduml
