@startuml
autonumber
participant "run_once()" as W
participant "enrich_aircraft()" as EA
participant "adsbdb" as A
participant "planespotters" as P
database "PostgreSQL" as DB
actor "User" as U
participant "API FastAPI\naircraft_detail()" as API

== Enrichment (asynchronous) ==
W -> DB : AIRCRAFT_TODO (visible, to be enriched or expired)
DB --> W : hexes[]
loop for each hex
  W -> EA : enrich_aircraft(conn, clients, hex)
  activate EA
  EA -> A : fetch_aircraft(hex)
  A --> EA : AircraftInfo | None
  EA -> P : fetch_photo(hex)
  P --> EA : Photo | None
  alt EnrichmentError
    EA -> EA : status = "error"
  else info or photo
    EA -> EA : status = "ok"
  else none
    EA -> EA : status = "not_found"
  end
  EA -> DB : UPDATE aircraft SET col = COALESCE(new, col), ...\n+ COMMIT
  deactivate EA
end

== Query by user ==
U -> API : GET /aircraft/{hex}
activate API
API -> API : validates ^[0-9a-fA-F]{6}$
API -> DB : AIRCRAFT (hex)
DB --> API : row | empty
alt empty
  API --> U : 404 "Unknown aircraft"
else found
  API -> DB : AIRCRAFT_LIVE (hex)
  DB --> API : live state | empty
  API --> U : 200 { registration, type_name, photo_url,\nphoto_credit, ..., live: {...} | null }
end
deactivate API
@enduml
