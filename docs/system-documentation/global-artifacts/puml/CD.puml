@startuml CD
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

title SkyTracer — Class Diagram (backend: Node.js)

package "main" {
  class main <<module>> {
    - shutdown() : void <<async>>
  }
}

package "server" {
  class server <<module>> {
    + handle(request : Request, tracker : Tracker, cfg : Config) : Response <<async>>
    + startServer(tracker : Tracker, cfg : Config, port : number) : Server
    - corsHeaders(origin : string | null, cfg : Config) : Record<string, string>
    - toRequest(req : IncomingMessage) : Request
  }
}

package "config" {
  class Config <<interface>> {
    + port : number
    + dump1090Url : string
    + networkUrl : string
    + networkIntervalMs : number
    + pollIntervalMs : number
    + positionMinIntervalMs : number
    + flushIntervalMs : number
    + liveExpiryMs : number
    + aircraftTtlMs : number
    + routeTtlMs : number
    + userAgent : string
    + corsOrigins : string[]
    + supabaseUrl : string
    + supabaseKey : string
  }
  class config <<module>> {
    + loadConfig(env : Env = process.env) : Config
  }
}

package "tracker" {
  class Tracker {
    - cfg : Config
    - db : Supabase
    - collector : Collector
    - enricher : Enricher
    - lastFlush : number
    - lastRead : number | null
    - network : Map<string, NetworkAircraft>
    - lastNetworkRead : number | null
    - clients : Set<WebSocket>
    - timer : Timeout
    - running : boolean
    --
    + start() : void
    + stop() : void <<async>>
    + tick(now : number) : void <<async>>
    + flush() : void <<async>>
    + liveAircraft(maxAgeS : number, now : number) : object[]
    + addClient(ws : WebSocket) : void
    + handle(request : Request) : Response <<async>>
    - readNetwork(now : number) : void <<async>>
    - present(live : LiveAircraft, source, network?) : object
    - liveMessage(now : number) : string
  }
}

package "dump1090" {
  class AircraftState <<interface>> {
    + hex : string
    + ts : number
    + posTs : number | null
    + callsign : string | null
    + lat : number | null
    + lon : number | null
    + altitudeFt : number | null
    + onGround : boolean
    + speedKt : number | null
    + trackDeg : number | null
    + vertRateFpm : number | null
    + squawk : string | null
    + rssiDbfs : number | null
    + mlat : boolean
    + seenS : number | null
    + seenPosS : number | null
    + category : string | null
    + nucp : number | null
  }
  class Snapshot <<interface>> {
    + now : number
    + messagesTotal : number | null
    + aircraft : AircraftState[]
  }
  class dump1090 <<module>> {
    + MAX_POSITION_AGE_S = 60
    --
    + parseSnapshot(payload : unknown) : Snapshot
    + parseAircraft(raw : object, now : number) : AircraftState | null
    + hasPosition(a : AircraftState) : boolean
    + hasFreshPosition(a : AircraftState) : boolean
  }
}

package "network" {
  class NetworkExtra <<interface>> {
    + alt_geom_ft, tas_kt, ias_kt : number | null
    + mach : number | null
    + wind_dir_deg, wind_speed_kt : number | null
    + oat_c : number | null
  }
  class NetworkAircraft <<interface>> {
    + state : AircraftState
    + registration, icao_type, type_name : string | null
    + extra : NetworkExtra
  }
  class network <<module>> {
    + NETWORK_NAME = "adsb.fi"
    --
    + parseNetwork(payload : unknown) : {now, aircraft : NetworkAircraft[]}
    + hasExtra(e : NetworkExtra) : boolean
  }
}

package "collector" {
  class LiveAircraft <<interface>> {
    + hex : string
    + seenAt : number
    + posAt : number | null
    + callsign : string | null
    + lat, lon : number | null
    + altitudeFt : number | null
    + onGround : boolean
    + speedKt, trackDeg : number | null
    + vertRateFpm : number | null
    + squawk, category : string | null
    + rssiDbfs : number | null
    + mlat : boolean
  }
  class Batch <<interface>> {
    + aircraft : AircraftRow[]
    + positions : PositionRow[]
    + snapshots : SnapshotRow[]
  }
  class Collector {
    + live : Map<string, LiveAircraft>
    - lastPosition : Map<string, number>
    - lastSnapshot : number | null
    - aircraft : Map<string, AircraftRow>
    - positions : PositionRow[]
    - snapshots : SnapshotRow[]
    --
    + ingest(snap : Snapshot) : number
    + takeBatch() : Batch | null
    + restore(batch : Batch) : void
  }
}

package "enrichment" {
  class ApiGate {
    - nextAllowed : number
    - failures : number
    - userAgent : string
    - minIntervalMs : number
    - backoffBaseMs : number
    - backoffMaxMs : number
    --
    + ready(now : number) : boolean
    + getJson(url : string, now : number) : Fetched <<async>>
    - backoff(now, resp, reason) : Fetched
  }
  class Fetched <<union>> {
    ok | not_found | retry | error
  }
  class AircraftInfo <<interface>> {
    + registration : string | null
    + icao_type : string | null
    + type_name : string | null
    + manufacturer : string | null
    + operator : string | null
    + country : string | null
  }
  class RouteInfo <<interface>> {
    + airline_name, airline_icao, airline_iata : string | null
    + origin_icao, origin_iata, origin_name : string | null
    + origin_lat, origin_lon : number | null
    + dest_icao, dest_iata, dest_name : string | null
    + dest_lat, dest_lon : number | null
  }
  class Photo <<interface>> {
    + photo_url : string
    + photo_credit : string | null
    + photo_link : string | null
  }
  class adsbdb <<module>> {
    + parseAircraft(payload : unknown) : AircraftInfo | null
    + parseRoute(payload : unknown) : RouteInfo | null
  }
  class planespotters <<module>> {
    + parsePhoto(payload : unknown) : Photo | null
  }
  class Enricher {
    + aircraft : Map<string, AircraftEnrichment>
    + routes : Map<string, RouteEnrichment | null>
    - retries : Map<string, number>
    - persist : Set<string>
    --
    + step(receiver : Iterable<InView>, now : number, others : Iterable<InView>) : void <<async>>
    - loadCached(hexes, callsigns) : void <<async>>
    - settle(key, results : Fetched[]) : EnrichStatus | null
    - enrichAircraft(hex : string, now : number) : void <<async>>
    - enrichRoute(callsign : string, now : number) : void <<async>>
  }
}

package "supabase" {
  class Supabase {
    - url : string
    - key : string
    --
    + select<T>(table : string, query : string) : T[] <<async>>
    + rpc(fn : string, args : object) : unknown <<async>>
  }
  class SupabaseError <<Error>>
}

main ..> config : loadConfig
main ..> Tracker : creates, start / stop
main ..> server : startServer
server ..> Tracker : forwards requests and WebSocket clients
server ..> Config

Tracker "1" *-- "1" Collector
Tracker "1" *-- "1" Enricher
Tracker "1" *-- "1" Supabase
Tracker ..> dump1090 : parseSnapshot
Tracker ..> Config
Tracker "1" o-- "*" NetworkAircraft : network (live only)
Tracker ..> network : parseNetwork
network ..> NetworkAircraft : creates
network ..> dump1090 : parseAircraft
NetworkAircraft *-- NetworkExtra
NetworkAircraft *-- AircraftState

Snapshot "1" *-- "*" AircraftState
dump1090 ..> Snapshot : creates
Collector ..> Snapshot : ingests
Collector "1" *-- "*" LiveAircraft : live
Collector ..> Batch : creates

Enricher "1" o-- "2" ApiGate : adsbdb / planespotters
Enricher ..> Supabase : cache and saves
Enricher ..> adsbdb : uses
Enricher ..> planespotters : uses
ApiGate ..> Fetched : returns
adsbdb ..> AircraftInfo : creates
adsbdb ..> RouteInfo : creates
planespotters ..> Photo : creates
Supabase ..> SupabaseError : throws
@enduml
