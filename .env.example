# Fonte obrigatória (dump1090 do professor)
DUMP1090_URL=https://ads-b.jcboliveira.xyz/dump1090/data/aircraft.json
POLL_INTERVAL_SECONDS=1
# Guardar posição de cada avião no máximo a cada N segundos (evita milhões de linhas/dia)
POSITION_MIN_INTERVAL_SECONDS=5
# Resumo do recetor (mensagens, nº de aviões) a cada N segundos
SNAPSHOT_INTERVAL_SECONDS=10
# Avião sai do estado live ao fim de N segundos sem mensagens
LIVE_EXPIRY_SECONDS=300
# Retenção: posições e snapshots com mais de N dias são apagados (limpeza diária)
RETENTION_DAYS=30

# PostgreSQL (usado pelo docker compose para criar a BD)
# Em produção: password própria, só letras e números (p. ex. `openssl rand -hex 24`),
# e atualizar também o DATABASE_URL. O .env nunca vai para o git.
POSTGRES_USER=skytracer
POSTGRES_PASSWORD=skytracer
POSTGRES_DB=skytracer
# Ligação usada pelos serviços quando correm fora do Docker (no Docker é gerada a partir das variáveis acima)
DATABASE_URL=postgresql://skytracer:skytracer@localhost:5432/skytracer

# API
API_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
WS_INTERVAL_SECONDS=1

# Enriquecimento (adsbdb + planespotters). O planespotters exige contacto no User-Agent.
HTTP_USER_AGENT=SkyTracer/0.1 (+https://github.com/miguelsiilva1/SkyTracer)
ENRICH_REQUESTS_PER_SECOND=1
ENRICH_INTERVAL_SECONDS=5
AIRCRAFT_TTL_DAYS=30
ROUTE_TTL_DAYS=7
