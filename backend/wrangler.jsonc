{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skytracer",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-24",
	"upload_source_maps": true,
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }],
	// Non-secret settings. SUPABASE_URL, SUPABASE_SECRET_KEY and HTTP_USER_AGENT are secrets
	// (`wrangler secret put`), and `.dev.vars` for local development.
	"vars": {
		"DUMP1090_URL": "https://ads-b.jcboliveira.xyz/dump1090/data/aircraft.json",
		"POLL_INTERVAL_SECONDS": "3",
		"POSITION_MIN_INTERVAL_SECONDS": "15",
		"FLUSH_INTERVAL_SECONDS": "15",
		"LIVE_EXPIRY_SECONDS": "300",
		"AIRCRAFT_TTL_DAYS": "30",
		"ROUTE_TTL_DAYS": "7",
		"API_CORS_ORIGINS": "https://miguelsiilva1.github.io,http://localhost:8081,http://localhost:19006"
	}
}
